# Copy to .env.local for local development:  cp .env.example .env.local
# On Vercel, set these in Project Settings → Environment Variables instead.

# --- Database (Postgres) -----------------------------------------------------
# Local:   postgres://ascent:ascent@127.0.0.1:5432/ascent
# Vercel:  use the pooled connection string from your Neon (or other) Postgres.
#          The Neon integration on the Vercel Marketplace sets this for you.
DATABASE_URL=postgres://ascent:ascent@127.0.0.1:5432/ascent
# Optional: direct (non-pooled) URL. Used only by the CLI scripts (db:migrate,
# user:create, import:curriculum) when set; the app itself always uses DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Optional: max connections per server instance (default 5 in production, 10 in dev).
# Keep it small on serverless; the pooled URL does the real pooling.
# DB_POOL_MAX=5

# --- Sessions ----------------------------------------------------------------
# Long random string (32+ characters) used to sign login cookies:
#   openssl rand -base64 32
# Use a different value per environment. Changing it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Demo mode ---------------------------------------------------------------
# Set to 1 ONLY on throwaway/demo deployments: shows demo logins on the sign-in page.
# It is inlined at build time, so redeploy after changing it.
# NEXT_PUBLIC_DEMO_MODE=1

# --- Tests -------------------------------------------------------------------
# Template database for integration tests (created and migrated automatically;
# each test file gets its own clone). The user needs CREATEDB.
# DATABASE_URL_TEST=postgres://ascent:ascent@127.0.0.1:5432/ascent_test

# --- Scripts -----------------------------------------------------------------
# `npm run user:create` reads the new password from here if set, otherwise it
# prompts. Prefer the prompt; don't leave a real password in this file.
# ASCENT_NEW_PASSWORD=
